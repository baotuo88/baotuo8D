# PostgreSQL
POSTGRES_DB=eightd_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=eight_d_reports
CHROMA_RAG_COLLECTION=rag_case_chunks

# AI bootstrap defaults
# Used only for first-time seed into ai_runtime_config when DB row is empty.
# Runtime calls always read from database config.
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=25000
AI_RETRY_COUNT=1
REDIS_URL=redis://redis:6379
QUEUE_RAG_INGESTION_NAME=rag-ingestion
QUEUE_RAG_INGESTION_CONCURRENCY=2
QUEUE_RAG_INGESTION_ATTEMPTS=3

# Auth / Security
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=12h
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
SECURITY_ENABLE_HELMET=true
SECURITY_GLOBAL_RATE_WINDOW_MS=60000
SECURITY_GLOBAL_RATE_MAX=300
SECURITY_AUTH_RATE_WINDOW_MS=60000
SECURITY_AUTH_RATE_MAX=20
METRICS_TOKEN=replace_with_metrics_token_for_prometheus
METRICS_ALLOWED_IPS=127.0.0.1
SECRET_CRYPTO_KEY=replace_with_a_random_secret_for_db_secret_encryption

# Optional: allow admin registration through /api/auth/register
ADMIN_REGISTER_TOKEN=

# Document Processing
DOCUMENT_UPLOAD_DIR=/tmp/8d-doc-upload
DOCUMENT_IMPORT_ROOT=/tmp
DOCUMENT_BATCH_CONCURRENCY=4
DOCUMENT_MAX_UPLOAD_FILES=50
DOCUMENT_MAX_IMPORT_FILES=1000
DOCUMENT_MAX_UPLOAD_FILE_SIZE_MB=20

# RAG
RAG_CHUNK_MIN_CHARS=300
RAG_CHUNK_MAX_CHARS=500
RAG_RECALL_LIMIT=10
RAG_TOP_CASE_LIMIT=3

# Service / Runtime
BACKEND_PORT=8080
FRONTEND_PORT=3000
BACKEND_SERVICE_NAME=eightd-backend
BACKEND_LOG_LEVEL=info
BACKEND_LOG_PRETTY=false
HEALTHCHECK_TIMEOUT_MS=3000
TZ=Asia/Shanghai

# Docker Compose profile: dev | prod (compose 服务都带 profiles，必须设置否则会出现 'no service selected')
COMPOSE_PROFILES=prod
